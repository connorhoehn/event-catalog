{
  "name": "@connorhoehn/event-catalog",
  "version": "0.9.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Unified event registry and transport layer — schema enforcement, metrics, and admin UI over Redis pub/sub and message-queue",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "event-catalog": "./dist/cli/index.js",
    "ec-lint-crd": "./dist/cli/lint-crd.js",
    "ec-bundle-diff": "./dist/cli/bundle-diff.js",
    "ec-bundle-create": "./dist/cli/bundle-create.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./signal": {
      "types": "./dist/client/signal.d.ts",
      "default": "./dist/client/signal.js"
    },
    "./durable": {
      "types": "./dist/client/durable.d.ts",
      "default": "./dist/client/durable.js"
    },
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    },
    "./dlq": {
      "types": "./dist/dlq/index.d.ts",
      "default": "./dist/dlq/index.js"
    },
    "./types": {
      "types": "./dist/generated/event-types.d.ts",
      "default": "./dist/generated/event-types.js"
    },
    "./client-frames": {
      "types": "./dist/generated/client-frames.d.ts",
      "default": "./dist/generated/client-frames.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "templates"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "dev:stack": "bash scripts/dev.sh",
    "build": "tsc",
    "build:cli": "tsc --target ES2022 --module node16 --moduleResolution node16 --outDir ./dist --rootDir ./src --strict --declaration --declarationMap --sourceMap --esModuleInterop --skipLibCheck --resolveJsonModule --isolatedModules --noFallthroughCasesInSwitch src/cli/bundle-create.ts src/cli/bundle-diff.ts src/cli/lint-crd.ts src/cli/index.ts",
    "build:admin": "cd src/admin && npm run build",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:all": "tsc --noEmit -p tsconfig.lint.json",
    "generate-types": "tsx scripts/generate-types.ts",
    "generate-asyncapi": "tsx scripts/generate-asyncapi.ts",
    "snapshot:regen": "tsx scripts/regen-registry-snapshot.ts",
    "verify:dist": "node scripts/verify-dist-completeness.mjs",
    "prepublishOnly": "tsx scripts/regen-registry-snapshot.ts && npm run verify:dist",
    "openapi:check": "tsx scripts/openapi-check.ts",
    "test:e2e": "playwright test",
    "verify:durable": "npm run build && node scripts/verify-durable-package.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "@connorhoehn/service-runtime": "github:connorhoehn/service-runtime#5f7275e5f53377526a82076714618672f8f53d22",
    "@connorhoehnslalom/message-queue": "github:connorhoehnslalom/message-queue#316c35f3694f8110ae7bd0fbb3097881cddc849b",
    "distributed-core": "github:connorhoehn/distributed-core#077d7594cc412e3153ace47ce0f0b4be60df84d5",
    "pino": "9.14.0",
    "redis": "^4.7.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
