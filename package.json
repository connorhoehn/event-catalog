{
  "name": "@connorhoehn/event-catalog",
  "version": "0.3.32",
  "description": "Unified event registry and transport layer — schema enforcement, metrics, and admin UI over Redis pub/sub and message-queue",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "event-catalog": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "dev:stack": "bash scripts/dev.sh",
    "build": "tsc",
    "build:admin": "cd src/admin && npm run build",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "snapshot:regen": "tsx scripts/regen-registry-snapshot.ts",
    "prepublishOnly": "tsx scripts/regen-registry-snapshot.ts",
    "openapi:check": "tsx scripts/openapi-check.ts",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "cors": "^2.8.5",
    "distributed-core": "github:connorhoehn/distributed-core#distributed-core-v0.31.0",
    "express": "^4.21.0",
    "redis": "^4.7.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@connorhoehn/message-queue": "github:connorhoehnslalom/message-queue#main"
  },
  "peerDependenciesMeta": {
    "@connorhoehn/message-queue": {
      "optional": true
    }
  }
}
